{
  "name": "fintrace",
  "version": "0.1.0",
  "private": true,
  "description": "Graph-based AML/transaction monitoring engine",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx watch src/worker.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:postgres": "tsx src/db/migratePostgres.ts",
    "db:seed": "tsx src/db/seedUsers.ts",
    "db:explain": "tsx src/db/explainQueries.ts",
    "generate:data": "tsx src/scripts/generateSyntheticData.ts",
    "load-test": "tsx src/scripts/loadTest.ts",
    "build": "tsc -p tsconfig.build.json && npm run build:assets",
    "build:assets": "mkdir -p dist/db/migrations && cp src/db/migrations/*.sql dist/db/migrations/",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "start:migrate": "node dist/db/migrate.js && node dist/db/migratePostgres.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run 'src/**/*.integration.test.ts'"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.1",
    "@fastify/rate-limit": "^9.1.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.1.1",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "ioredis": "^6.0.0",
    "neo4j-driver": "^6.2.0",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "zod": "^4.4.3"
  },
  "overrides": {
    "fast-jwt": "^6.3.2"
  },
  "devDependencies": {
    "@testcontainers/neo4j": "^12.1.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/autocannon": "^7.12.7",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.21.0",
    "@typescript-eslint/eslint-plugin": "^7.16.1",
    "@typescript-eslint/parser": "^7.16.1",
    "autocannon": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "testcontainers": "^12.1.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3"
  }
}
